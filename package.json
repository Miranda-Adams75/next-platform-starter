{
  "name": "gg-desktop-mascot",
  "version": "1.1.0",
  "private": true,
  "description": "Local Electron desktop mascot overlay for Windows",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.digitalfrontporch.gg",
    "productName": "GG Desktop Mascot",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "settings.json",
      ".env.example"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  }
}
